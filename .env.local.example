# ============================================================
# ReceiptScan — Environment Variables
# Copy this file to .env.local and fill in real values.
# ============================================================

# --- OpenRouter ---
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Your deployed site URL (for OpenRouter headers) — change to your Vercel URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Cloud Service Account ---
# Download the JSON key from Google Cloud Console
# (IAM & Admin > Service Accounts > Keys > Add Key > JSON)
# Paste the ENTIRE JSON content as a single-line string.
# Required APIs to enable: Cloud Vision API, Google Drive API
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"receipts@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
